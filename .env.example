# M3 (MiniMax M3) Configuration
# 留空时,sidecar 会进入 mock 模式(返回假数据),用于本地开发与无 key 调试。
M3_BASE_URL=https://openrouter.ai/api/v1
M3_API_KEY=
# OpenRouter 上 MiniMax-M3 的实际 model id
M3_MODEL=minimax/minimax-m3

# Sidecar 服务端口(留空则由 sidecar 启动时随机分配,自动写到 workspace/.sidecar-port)
SIDECAR_PORT=

# Workspace 路径(留空则使用项目根目录下的 ./workspace/)
WORKSPACE_PATH=

# 日志级别:DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
